{
 "uid": "lab6-portales",
 "title": "Lab 6 - WordPress y PrestaShop en AKS",
 "schemaVersion": 39,
 "version": 1,
 "tags": [
  "lab6"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Pods Running - WordPress",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-lab6"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_phase{namespace=\"wordpress\",phase=\"Running\"})",
     "legendFormat": "wordpress",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-lab6"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "title": "Pods Running - PrestaShop",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-lab6"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_phase{namespace=\"prestashop\",phase=\"Running\"})",
     "legendFormat": "prestashop",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-lab6"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "title": "Reinicios de contenedores (acumulado)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-lab6"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace) (kube_pod_container_status_restarts_total{namespace=~\"wordpress|prestashop\"})",
     "legendFormat": "{{namespace}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-lab6"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "title": "Pods Ready",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-lab6"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace) (kube_pod_status_ready{namespace=~\"wordpress|prestashop\",condition=\"true\"})",
     "legendFormat": "{{namespace}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-lab6"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "title": "CPU por pod (cores)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-lab6"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"wordpress|prestashop\",container!=\"\"}[5m]))",
     "legendFormat": "{{namespace}} / {{pod}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-lab6"
     },
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 6,
   "title": "Memoria por pod",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-lab6"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"wordpress|prestashop\",container!=\"\"})",
     "legendFormat": "{{namespace}} / {{pod}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-lab6"
     },
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 7,
   "title": "Pods de los dos portales (estado)",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-lab6"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (namespace, pod, phase) (kube_pod_status_phase{namespace=~\"wordpress|prestashop\"} == 1)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-lab6"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}